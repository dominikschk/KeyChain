# Secrets für lokalen / echten Bambu-Test
# cp .env.bambu.local.example .env.bambu.local

BAMBU_BRIDGE_SECRET=local-test-secret
BAMBU_PRINTER_ID=MOCK-PRINTER-001
BAMBU_AUTO_PRINT=false
BAMBU_GATEWAY_URL=http://127.0.0.1:4844

# Optional Orca-Profile (wenn orcaslicer-headless läuft)
# BAMBU_MACHINE_PROFILE=
# BAMBU_PROCESS_PROFILE=
